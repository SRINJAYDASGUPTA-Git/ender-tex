pipeline {

    agent {
        label 'node-agent'
    }

    environment {
        PROJECT_NAME = 'ender-tex-frontend'

        IMAGE_NAME = "srinjay2004/ender-tex-frontend"

        // Production
        CONTAINER_NAME = "ender-tex-frontend"
        CONTAINER_PORT = "3000"
        HOST_PORT = "3002"

        // Temporary E2E deployment
//        TEST_CONTAINER_NAME = "ender-does-frontend-test"
//        TEST_HOST_PORT = "3001"

        DEPLOY_HOST = '172.17.0.1'

        // E2E target
//        E2E_BASE_URL = "http://$TEST_CONTAINER_NAME:$CONTAINER_PORT"
    }

    stages {

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Install Dependencies") {
            steps {
                dir("frontend") {
                    sh "npm ci"
                }
            }
        }

//        stage("Install Playwright Browser") {
//            steps {
//                dir("ender-does-frontend") {
//                    sh "npx playwright install chromium"
//                }
//            }
//        }

        stage("Build") {
            steps {
                dir("frontend") {
                    sh "npm run build"
                }
            }
        }

        stage("Build Docker Image") {
            steps {
                dir("frontend") {
                    sh """
                        docker build \
                            -t ${IMAGE_NAME}:${BUILD_NUMBER} \
                            -t ${IMAGE_NAME}:latest \
                            .
                    """
                }
            }
        }

//        /*

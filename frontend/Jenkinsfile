        /*
         * ---------------------------------------------------------
         * DOCKER HUB
         * ---------------------------------------------------------
         *
         * Image is pushed only after E2E tests pass.
         */

        stage("Push Docker Image") {

            steps {

                withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub-credentials',
                            usernameVariable: 'DOCKER_USER',
                            passwordVariable: 'DOCKER_PASSWORD'
                        )
                    ]) {

                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USER" \
                            --password-stdin

                        docker push "$IMAGE_NAME:$BUILD_NUMBER"

                        docker push "$IMAGE_NAME:latest"

                        docker logout
                    '''
                }
            }
        }

        /*
         * ---------------------------------------------------------
         * PRODUCTION DEPLOYMENT
         * ---------------------------------------------------------
         *
         * This stage cannot execute if E2E tests fail.
         */

        stage("Deploy Container") {

            steps {

                withCredentials([
                        string(
                            credentialsId: 'imgbb-api-key',
                            variable: 'IMGBB_API_KEY'
                        ),
                        string(
                            credentialsId: 'enderdoes-test-user-password',
                            variable: 'TEST_USER_PASSWORD'
                        )
                    ]) {

                    sh '''
                        echo "Deploying production frontend..."

                        docker rm -f "$CONTAINER_NAME" || true

                        docker run -d \
                            --name "$CONTAINER_NAME" \
                            --network apps \
                            -p "$HOST_PORT:$CONTAINER_PORT" \
                            -e NODE_ENV=production \
                            -e BACKEND_URL=https://api-paper.srinjaydg.in \
                            "$IMAGE_NAME:$BUILD_NUMBER"

                        echo "Production container started."
                    '''
                }
            }

            post {

                failure {
                    sh '''
                        echo "Production deployment failed."

                        docker logs "$CONTAINER_NAME" || true
                    '''
                }
            }
        }

        stage("Verify Deployment") {

            steps {

                sh '''
                    echo "Waiting for production frontend..."

                    for i in $(seq 1 30); do

                        if curl -fsS \
                            http://$CONTAINER_NAME:$CONTAINER_PORT/login \
                            > /dev/null; then

                            echo "Frontend is running."
                            exit 0
                        fi

                        echo "Attempt $i/30: production frontend not ready."

                        sleep 2
                    done

                    echo "Frontend failed to start."

                    docker logs "$CONTAINER_NAME" || true

                    exit 1
                '''
            }
        }

        /*
         * ---------------------------------------------------------
         * CLOUDFLARE
         * ---------------------------------------------------------
         */

        stage("Configure Subdomain") {

            steps {

                withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'deployment-user-ssh-creds',
                            keyFileVariable: 'SSH_KEY',
                            usernameVariable: 'SSH_USER'
                        )
                    ]) {

                    sh '''
                        set +x

                        echo "Configuring frontend subdomain..."

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@${DEPLOY_HOST}" \
                            "sudo -n /usr/local/bin/deploy-subdomain frontend ender-tex 3000"

                        echo "Cleaning unused Docker images..."

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@${DEPLOY_HOST}" \
                            "docker image prune -f"
                    '''
                }
            }
        }
    }

    /*
     * -------------------------------------------------------------
     * PIPELINE EMAILS
     * -------------------------------------------------------------
     */

    post {

        success {

            echo "Deployment successful: ${IMAGE_NAME}:${BUILD_NUMBER}"

            emailext(
                to: 'dasguptasrinjay2004@gmail.com',

                subject:
                "🚀 Deployment Successful — ${PROJECT_NAME} #${BUILD_NUMBER}",

                mimeType: 'text/html',

//                attachmentsPattern:
//                '**/reports/cucumber/cucumber-report-*.pdf',

                body: """
                    <div style="
                        font-family: Arial, sans-serif;
